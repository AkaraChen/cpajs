{
  "name": "@cpajs/codex-auth",
  "version": "0.1.0-rc.7",
  "description": "Sign in with ChatGPT (Codex device flow) and build the auth file CLIProxyAPI reads, with zero runtime dependencies",
  "license": "MIT",
  "author": "akarachen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkaraChen/cpajs.git",
    "directory": "packages/codex-auth"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cpa": {
      "types": "./dist/cpa.d.ts",
      "default": "./dist/cpa.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@cpajs/cpa": "^0.1.0-rc"
  },
  "peerDependenciesMeta": {
    "@cpajs/cpa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  }
}
