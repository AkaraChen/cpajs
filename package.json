{
  "name": "@cpajs/cpa",
  "version": "0.0.1-alpha-3",
  "description": "Run the official CLIProxyAPI from JavaScript and talk to its v8 management API with a typed client",
  "license": "MIT",
  "author": "akarachen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkaraChen/cpajs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "cpa:source": "node scripts/fetch-source.ts",
    "cpa:build": "node scripts/build-binary.ts",
    "cpa:verify": "node scripts/verify-binary.ts",
    "packages:assemble": "node scripts/assemble-packages.ts",
    "prepack": "pnpm run build",
    "packages:pack": "node scripts/pack.ts",
    "test:install": "node scripts/install-test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  }
}
