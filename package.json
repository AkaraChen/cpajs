{
  "name": "cpajs-monorepo",
  "private": true,
  "description": "Workspace tooling for the @cpajs/* packages",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "pnpm -r test:e2e",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "cpa:source": "node scripts/fetch-source.ts",
    "cpa:build": "node scripts/build-binary.ts",
    "cpa:verify": "node scripts/verify-binary.ts",
    "panel:fetch": "node scripts/fetch-panel.ts",
    "binary:generate": "node scripts/generate-binary-table.ts",
    "binary:check": "node scripts/generate-binary-table.ts --check",
    "packages:assemble": "node scripts/assemble-packages.ts",
    "packages:pack": "node scripts/pack.ts",
    "test:install": "node scripts/install-test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3"
  },
  "packageManager": "pnpm@11.20.0"
}
